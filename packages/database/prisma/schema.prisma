// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider     = "prisma-client"
  output       = "../src/database/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "sqlite"
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  roleId    String
  role      Role     @relation(fields: [roleId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("Users")
}

model Role {
  id              String           @id
  name            String
  users           User[]
  rolePermissions RolePermission[] @relation("RoleToRolePermission")
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@map("Roles")
}

model RolePermission {
  id           String     @id
  roleId       String
  role         Role       @relation("RoleToRolePermission", fields: [roleId], references: [id])
  permissionId String
  permission   Permission @relation("PermissionToRolePermissions", fields: [permissionId], references: [id])
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@map("RolePermissions")
}

model Permission {
  id   String @id
  name String

  rolePermissions RolePermission[] @relation("PermissionToRolePermissions")
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@map("Permissions")
}

