// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider     = "prisma-client"
  output       = "../src/database/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "sqlite"
}

model User {
  id       String @id
  nickname String
  roleId   String
  role     Role   @relation(fields: [roleId], references: [id])
}

model Role {
  id              String            @id
  name            String
  users           User[]
  rolePermissions RolePermissions[] @relation("RoleToRolePermission")
}

model RolePermissions {
  id           String     @id
  roleId       String
  role         Role       @relation("RoleToRolePermission", fields: [roleId], references: [id])
  permissionId String
  permission   Permission @relation("PermissionToRolePermissions", fields: [permissionId], references: [id])
}

model Permission {
  id   String @id
  name String

  rolePermissions RolePermissions[] @relation("PermissionToRolePermissions")
}
