{
  "extends": "@panda-chat/typescript-config/react-library.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist",
    "strictNullChecks": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["./*"]
    },
    "moduleResolution": "bundler",
    "resolvePackageJsonImports": true
  },
  "include": ["src"],
  "exclude": ["node_modules", "dist"]
}
